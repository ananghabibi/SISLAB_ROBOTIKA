{
  "name": "silab",
  "version": "0.1.0",
  "private": true,
  "description": "SILAB — Sistem Informasi Laboratorium Robotika FT UNISMA",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "siapkan": "node scripts/siapkan-env.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "sandi": "tsx scripts/set-sandi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.545.0",
    "next": "15.5.24",
    "next-auth": "5.0.0-beta.32",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.15.3",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.1.2"
  }
}
