# =============================================================================
# SILAB — contoh variabel lingkungan. Salin menjadi .env lalu isi nilainya.
# =============================================================================

# --- Basis data --------------------------------------------------------------
POSTGRES_USER=silab
POSTGRES_PASSWORD=ubah-kata-sandi-ini
POSTGRES_DB=silab
# Di dalam Docker Compose host-nya "db"; untuk pengembangan lokal pakai localhost.
DATABASE_URL="postgresql://silab:ubah-kata-sandi-ini@localhost:5432/silab?schema=public"

# --- Auth.js -----------------------------------------------------------------
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Wajib true di belakang Caddy / Cloudflare Tunnel.
AUTH_TRUST_HOST=true

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID, tipe Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Domain surel kampus yang boleh login lewat Google. Pisahkan dengan koma.
ALLOWED_EMAIL_DOMAINS=unisma.ac.id,student.unisma.ac.id

# --- Jaringan laboratorium (lapis 1 anti titip absen) ------------------------
# Daftar subnet CIDR yang diizinkan mengakses /api/attendance dan /display.
LAB_SUBNETS=192.168.1.0/24
# Isi true HANYA saat pengembangan di laptop; wajib false di laboratorium.
LAB_NETWORK_BYPASS=false

# --- Token QR berputar (lapis 3) ---------------------------------------------
# Buat dengan: openssl rand -hex 32
QR_TOKEN_SECRET=
QR_ROTATE_SECONDS=60
QR_MAX_AGE_SECONDS=90

# --- Cron internal -----------------------------------------------------------
# Dipakai untuk memanggil endpoint terjadwal dari kontainer cron.
CRON_SECRET=
TZ=Asia/Jakarta

# --- Seeder ------------------------------------------------------------------
# Kata sandi awal akun dosen (Credentials). WAJIB diganti setelah login pertama.
SEED_KEPALA_LAB_PASSWORD=ubah-setelah-login-pertama
